width='1.2'\/>\n\t\t\t\t<circle cx='8' cy='5.2' r='0.85' fill='currentColor'\/>\n\t\t\t\t<path fill='currentColor' d='M7.28 7.15h1.44v4.55H7.28z'\/>\n\t\t\t<\/svg>\n\t\t<\/button>\n\t\t<span class='cover-credit-popup'><a class=\"content-link cover-credit-link\" href=\"https:\/\/www.pexels.com\/\" target=\"_blank\" rel=\"noopener noreferrer\">Pexels<\/a> \u2014 <a class=\"content-link cover-credit-link\" href=\"https:\/\/www.pexels.com\/license\/\" target=\"_blank\" rel=\"noopener noreferrer\">Pexels License<\/a><\/span>\n\t<\/span>\n<\/p>\n\n\t<h2 class='center'>\u0935\u093f\u091a\u093e\u0930, \u0906\u0924\u094d\u092e-\u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e, \u091a\u0947\u0924\u0928\u093e \u0914\u0930 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u0907\u091a\u094d\u091b\u093e \u0915\u0940 \u091c\u093e\u0901\u091a<\/h2>\n\t\t<h3>\u201c\u092e\u0948\u0902\u201d \u0914\u0930 \u091a\u0947\u0924\u0928\u093e \u0915\u094b \u0915\u0948\u0938\u0947 \u0938\u092e\u091d\u0947\u0902?<\/h3>\n\t<p>\n\t\t\u0939\u092e \u0907\u0938 \u0938\u0902\u0938\u093e\u0930 \u0915\u093e \u092d\u093e\u0917 \u0939\u0948\u0902 \u0914\u0930 \u0909\u0938\u0940 \u092a\u0926\u093e\u0930\u094d\u0925 \u0938\u0947 \u092c\u0928\u0947 \u0939\u0948\u0902 \u091c\u093f\u0938\u0938\u0947 \u092c\u093e\u0915\u0940 \u0938\u0902\u0938\u093e\u0930 \u092c\u0928\u093e \u0939\u0948\u0964 \u092b\u093f\u0930 \u092d\u0940 \u0939\u092e\u092e\u0947\u0902 \u0915\u0941\u091b \u092c\u0939\u0941\u0924 \u0905\u0932\u0917 \u0939\u0948\u0964\n\t<\/p>\n\t<p>\n\t\t\u0939\u092e \u091c\u0940\u0935\u093f\u0924 \u0914\u0930 \u0938\u094b\u091a\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u094d\u0930\u093e\u0923\u0940 \u0939\u0948\u0902\u0964 \u0939\u092e \u0905\u092a\u0928\u0947 \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0938\u091a\u0947\u0924 \u0939\u0948\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0915\u0930\u094d\u092e \u091a\u0941\u0928\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u092d\u0935 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0939\u092e\u093e\u0930\u0947 \u091c\u091f\u093f\u0932 \u092e\u0938\u094d\u0924\u093f\u0937\u094d\u0915 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0938\u092e\u094d\u092d\u0935 \u0939\u0948\u0964\n\t<\/p>\n\t<p>\n\t\t\u092a\u0930 \u0915\u094d\u092f\u093e \u0939\u092e \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u0907\u0924\u0928\u0947 \u201c\u0935\u093f\u0936\u0947\u0937\u201d \u0914\u0930 \u0907\u0924\u0928\u0947 \u201c\u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930\u201d \u0939\u0948\u0902? \u0906\u0907\u090f \u091c\u093e\u0901\u091a\u0947\u0902\u0964\n\t<\/p>\n\t<h3>\u0935\u093f\u091a\u093e\u0930 \u0915\u094d\u092f\u093e \u0939\u0948?<\/h3>\n\t<p>\n\t\t\u0935\u093f\u091a\u093e\u0930 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915\u0924\u093e \u0915\u093e \u0906\u0902\u0936\u093f\u0915 \u0906\u092d\u093e\u0938\u0940 \u0905\u0928\u0941\u0915\u0930\u0923 \u0939\u0948\u0964 \u0935\u093f\u0915\u093e\u0938 \u0928\u0947 \u0907\u0938\u0947 \u091c\u0940\u0935\u093f\u0924 \u0930\u0939\u0928\u0947 \u092e\u0947\u0902 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u092c\u0928\u093e\u092f\u093e\u0964\n\t<\/p>\n\t<p>\n\t\t\u0909\u0926\u093e\u0939\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f, \u0905\u092a\u0928\u0940 \u0913\u0930 \u0926\u094c\u0921\u093c\u0924\u0947 \u0936\u093f\u0915\u093e\u0930\u0940 \u0915\u094b \u0926\u0947\u0916\u0915\u0930 \u0909\u0938\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0916\u093e \u0932\u093f\u090f \u091c\u093e\u0928\u0947 \u0915\u0940 \u0938\u092e\u094d\u092d\u093e\u0935\u0928\u093e \u0915\u093e \u0935\u093f\u091a\u093e\u0930 \u092a\u0948\u0926\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092f\u0939\u0940 \u0935\u093f\u091a\u093e\u0930 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u094b \u091c\u0940\u0935\u0928 \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0928\u0947 \u0915\u094b \u092a\u094d\u0930\u0947\u0930\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964\n\t<\/p>\n\t<h3>\u0906\u0924\u094d\u092e-\u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e \u0915\u094d\u092f\u093e \u0939\u0948?<\/h3>\n\t<p>\n\t\t\u091c\u094b \u0935\u093f\u091a\u093e\u0930 \u0905\u092a\u0928\u0947 \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935\u2014\u0905\u0930\u094d\u0925\u093e\u0924 \u0905\u0928\u0941\u0915\u0930\u0923 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0940 \u092a\u094d\u0930\u0923\u093e\u0932\u0940\u2014\u0915\u094b \u092d\u0940 \u091c\u093e\u0928\u0924\u093e \u0939\u0948, \u0909\u0938\u0947 \u0906\u0924\u094d\u092e-\u091c\u093e\u0917\u0930\u0942\u0915 \u0915\u0939\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\t<\/p>\n\t<p>\n\t\t\u0910\u0938\u0940 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u092e\u0947\u0902 \u201c\u092e\u0948\u0902\u201d \u0915\u093e \u092c\u094b\u0927 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0926\u0942\u0938\u0930\u0947 \u0936\u092c\u094d\u0926\u094b\u0902 \u092e\u0947\u0902, \u0935\u0939 \u0938\u094d\u0935\u092f\u0902 \u0915\u093e \u092d\u0940 \u0905\u0928\u0941\u0915\u0930\u0923 \u0915\u0930 \u0938\u0915\u0924\u0940 \u0939\u0948\u0964\n\t<\/p>\n\t<p>\n\t\t\u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0915\u093e\u0930 \u0915\u093e \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u092f\u0930 \u0905\u092a\u0928\u0947 \u0921\u094d\u0930\u093e\u0907\u0935\u093f\u0902\u0917-\u0905\u0928\u0941\u0915\u0930\u0923 \u092e\u0947\u0902 \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923 \u0915\u0947 \u0938\u093e\u0925 \u0938\u094d\u0935\u092f\u0902 \u0915\u094b \u092d\u0940 \u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0909\u0938\u0947 \u0905\u092a\u0928\u0947 \u0906\u0915\u093e\u0930, \u0938\u094d\u0925\u093f\u0924\u093f \u0914\u0930 \u0917\u0941\u0923\u094b\u0902 \u0915\u093e \u091c\u094d\u091e\u093e\u0928 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092f\u0926\u093f \u0935\u0939 \u092f\u0939 \u092d\u0940 \u091c\u093e\u0928\u0947 \u0915\u093f \u0905\u0928\u0941\u0915\u0930\u0923 \u091a\u0932\u093e \u0930\u0939\u0940 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0914\u0930 \u0905\u0928\u0941\u0915\u0930\u0923 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0909\u0938\u0915\u0940 \u091b\u0935\u093f \u090f\u0915 \u0939\u0940 \u0939\u0948, \u0924\u094b \u0909\u0938\u0947 \u0906\u0924\u094d\u092e-\u091c\u093e\u0917\u0930\u0942\u0915 \u0915\u0939\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n\t<\/p>\n\t<h3>\u091a\u0947\u0924\u0928\u093e \u0915\u094d\u092f\u093e \u0939\u0948?<\/h3>\n\t<p>\n\t\t\u091a\u0947\u0924\u0928\u093e \u092f\u0939 \u0938\u094b\u091a \u0938\u0915\u0928\u0947 \u0915\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u093f\u0938 \u0935\u093f\u0937\u092f \u092a\u0930 \u0938\u094b\u091a\u0928\u093e \u0939\u0948\u0964 \u091a\u0947\u0924\u0928 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0906\u0924\u094d\u092e-\u091c\u093e\u0917\u0930\u0942\u0915 \u0914\u0930 \u0938\u094d\u0935\u092f\u0902 \u0915\u094b \u0926\u093f\u0936\u093e \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948; \u0935\u0939 \u091a\u0941\u0928 \u0938\u0915\u0924\u0940 \u0939\u0948 \u0915\u093f \u0915\u093f\u0938 \u092c\u093e\u0924 \u092a\u0930 \u0935\u093f\u091a\u093e\u0930 \u0915\u0930\u0947\u0964\n\t<\/p>\n\t<p>\n\t\t\u0909\u0938\u0947 \u0915\u093f\u0938\u0940 \u092c\u093e\u0939\u0930\u0940 \u0938\u0902\u0938\u094d\u0925\u093e \u0938\u0947 \u0938\u0940\u0927\u0947 \u092f\u0939 \u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0928\u0939\u0940\u0902 \u0932\u0947\u0928\u093e \u092a\u0921\u093c\u0924\u093e \u0915\u093f \u0915\u094d\u092f\u093e \u0938\u094b\u091a\u0928\u093e \u0939\u0948\u0964 \u0935\u0939 \u0935\u093f\u091a\u093e\u0930\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0924\u0925\u093e \u0938\u0942\u091a\u0928\u093e \u0914\u0930 \u0915\u0930\u094d\u092e \u0915\u0947 \u092e\u093e\u0930\u094d\u0917-\u0928\u093f\u0930\u094d\u0927\u093e\u0930\u0923 \u0935\u093e\u0932\u093e \u092e\u0941\u0916\u094d\u092f \u092a\u094d\u0930\u094b\u0917\u094d\u0930\u093e\u092e \u0939\u0948\u0964\n\t<\/p>\n\t<h3>\u092e\u0928 \u0915\u094d\u092f\u093e \u0939\u0948?<\/h3>\n\t<p>\n\t\t\u092e\u0928 \u0935\u0939 \u0938\u0949\u092b\u094d\u091f\u0935\u0947\u092f\u0930 \u092e\u0902\u091a \u0939\u0948 \u091c\u093f\u0938 \u092a\u0930 \u0935\u093f\u091a\u093e\u0930\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0915\u0930\u0923 \u091a\u0932\u0924\u0947 \u0939\u0948\u0902\u0964\n\t<\/p>\n\n<\/div>\n\n<div id='updated-container'>\r\n\t<div id='updated'>\r\n\t\tUpdated:\r\n\t\t<span id='date'>\r\n\t\t\t2026 Aug 04\t\t<\/span>\r\n\t<\/div>\r\n<\/div>\r\n<div class='center' id='content-body-separator'><\/div>\r\n<div id='sub-list' class='center page-list'>\r\n<a\r\n\tclass='XURL item_block_container' href='\/hi\/world\/philosophy\/consciousness\/free_will' data-target='world\/philosophy\/consciousness\/free_will' data-title='\u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u0907\u091a\u094d\u091b\u093e'>\r\n<img class='item_block_image item_block_image_visible' src='\/world\/philosophy\/consciousness\/free_will.jpg' loading='lazy' alt=\"Navigation - link to world\/philosophy\/consciousness\/free_will\"><div class='item_block_text'><div>\u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u0907\u091a\u094d\u091b\u093e<\/div><\/div><\/a><\/div>\r\n<div id='fb_components'>\r\n\t<div class=\"fb-comments\"\n  data-href=\"https:\/\/ujnotes.com\/world\/philosophy\/consciousness\"\n  data-numposts=\"50\">\n<\/div>\n\t<div class=\"fb-like\"\n  data-href=\"https:\/\/ujnotes.com\/world\/philosophy\/consciousness\"\n  data-layout=\"button\"\n  data-action=\"like\"\n  data-size=\"small\"\n  data-show-faces=\"false\"\n  data-share=\"true\">\n<\/div>\n<\/div>\r\n<div id='nav-list' class='center page-list'>\r\n\t<a id='nav-menu-prev'\r\n\t\t\tclass='XURL item_bloc