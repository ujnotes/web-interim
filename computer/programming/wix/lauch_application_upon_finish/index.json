OGOPTIONALCHECKBOX = 1 and NOT Installed&lt;\/Publish&gt;<\/code><\/pre>\n\t<p>\n\t\tControl=\"Finish\".\n\t<\/p>\n\t<p>\n\t\tEvent=\"DoAction\".\n\t<\/p>\n\t<pre class='indent-c'><code class='block'>4. &lt;Publish Dialog=\"ExitDialog\" in &lt;UI&gt; after &lt;UIRef Id=\"WixUI_&lt;&gt;\" \/&gt;<\/code><\/pre>\n<\/div>\n\n<div id='updated-container'>\r\n\t<div id='updated'>\r\n\t\tUpdated:\r\n\t\t<span id='date'>\r\n\t\t\t2026 Aug 19\t\t<\/span>\r\n\t<\/div>\r\n<\/div>\r\n<div class='center' id='content-body-separator'><\/div>\r\n<div id='sub-list' class='center page-list'>\r\n<\/div>\r\n<div id='fb_components'>\r\n\t<div class=\"fb-comments\"\n  data-href=\"https:\/\/ujnotes.com\/computer\/programming\/wix\/lauch_application_upon_finish\"\n  data-numposts=\"50\">\n<\/div>\n\t<div class=\"fb-like\"\n  data-href=\"https:\/\/ujnotes.com\/computer\/programming\/wix\/lauch_application_upon_finish\"\n  data-layout=\"button\"\n  data-action=\"like\"\n  data-size=\"small\"\n  data-show-faces=\"false\"\n  data-share=\"true\">\n<\/div>\n<\/div>\r\n<div id='nav-list' class='center page-list'>\r\n\t<a id='nav-menu-prev'\r\n\t\t\tclass='XURL item_block_container' href='\/computer\/programming\/wix\/custom_action' data-target='computer\/programming\/wix\/custom_action' data-title='Custom Action' >\r\n\t\t<img class='item_block_image item_block_image_visible' src='\/resource\/placeholder.svg' loading='lazy' alt='Navigation - previous page tile'><div class='item_block_text'><div class='arrow'>&#x25C4;<\/div><div>Custom Action<\/div><\/div>\r\n\t\t<\/a><a id='nav-menu-next'\r\n\t\t\tclass='XURL item_block_container' href='\/computer\/programming\/wix\/notes' data-target='computer\/programming\/wix\/notes' data-title='Notes' >\r\n\t\t<img class='item_block_image item_block_image_visible item_block_image_contain' src='\/computer\/programming\/wix\/notes.svg' loading='lazy' alt='Navigation - next page tile'><div class='item_block_text'><div>Notes<\/div><div class='arrow'>&#x25BA;<\/div