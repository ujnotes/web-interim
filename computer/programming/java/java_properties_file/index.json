e\"));.\n\t<\/p>\n\t<p>\n\t\tSystem.out.println(prop.getProperty(\"app.version\"));.\n\t<\/p>\n\t<p>\n\t\tSystem.out.println(prop.getProperty(\"app.vendor\", \"Code Java\"));.\n\t<\/p>\n\t<p>\n\t\tDefault.\n\t<\/p>\n\t<pre class='indent-c'><code class='block'>}.<\/code><\/pre>\n\t<p>\n\t\tCatch (FileNotFoundException e).\n\t<\/p>\n\t<p>\n\t\t##\n\t<\/p>\n\t<p>\n\t\tE.printStackTrace();.\n\t<\/p>\n\t<pre class='indent-c'><code class='block'>}.<\/code><\/pre>\n\t<p>\n\t\tCatch (IOException e).\n\t<\/p>\n\t<p>\n\t\t##\n\t<\/p>\n\t<p>\n\t\tE.printStackTrace();.\n\t<\/p>\n\t<pre class='indent-c'><code class='block'>}.<\/code><\/pre>\n\t<pre class='indent-c'><code class='block'>}.<\/code><\/pre>\n\t<pre class='indent-c'><code class='block'>}.<\/code><\/pre>\n<\/div>\n\n<div id='updated-container'>\r\n\t<div id='updated'>\r\n\t\tUpdated:\r\n\t\t<span id='date'>\r\n\t\t\t2026 Aug 19\t\t<\/span>\r\n\t<\/div>\r\n<\/div>\r\n<div class='center' id='content-body-separator'><\/div>\r\n<div id='sub-list' class='center page-list'>\r\n<\/div>\r\n<div id='fb_components'>\r\n\t<div class=\"fb-comments\"\n  data-href=\"https:\/\/ujnotes.com\/computer\/programming\/java\/java_properties_file\"\n  data-numposts=\"50\">\n<\/div>\n\t<div class=\"fb-like\"\n  data-href=\"https:\/\/ujnotes.com\/computer\/programming\/java\/java_properties_file\"\n  data-layout=\"button\"\n  data-action=\"like\"\n  data-size=\"small\"\n  data-show-faces=\"false\"\n  data-share=\"true\">\n<\/div>\n<\/div>\r\n<div id='nav-list' class='center page-list'>\r\n\t<a id='nav-menu-prev'\r\n\t\t\tclass='XURL item_block_container' href='\/computer\/programming\/java\/java' data-target='computer\/programming\/java\/java' data-title='Java' >\r\n\t\t<img class='item_block_image item_block_image_visible' src='\/resource\/placeholder.svg' loading='lazy' alt='Navigation - previous page tile'><div class='item_block_text'><div class='arrow'>&#x25C4;<\/div><div>Java<\/div><\/div>\r\n\t\t<\/a><a id='nav-menu-next'\r\n\t\t\tclass=