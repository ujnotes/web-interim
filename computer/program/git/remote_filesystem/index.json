div>git remote add origin file:\/\/\/.<\/div><\/li>\n\t<\/ol>\n\t<h4>3. Push<\/h4>\n\t<pre class='indent-c'><code class='block'>1. git push --set-upstream origin master<\/code><\/pre>\n\t<pre class='indent-c'><code class='block'>\/ -u for --set-upstream<\/code><\/pre>\n\t<pre class='indent-c'><code class='block'>git remote set-url origin file:\/\/\/d\/Personal\/Project\/&lt;Project&gt;\/Repo\/&lt;Component&gt;\/Project<\/code><\/pre>\n\t<h2>git fetch suffices<\/h2>\n\t<p>\n\t\tBares can only fetch, and not pull.\n\t<\/p>\n\t<p>\n\t\tRemote cannot fetch from client.\n\t<\/p>\n\t<p>\n\t\tOnly client can push to origin.\n\t<\/p>\n<\/div>\n\n<div id='updated-container'>\r\n\t<div id='updated'>\r\n\t\tUpdated:\r\n\t\t<span id='date'>\r\n\t\t\t2026 Aug 19\t\t<\/span>\r\n\t<\/div>\r\n<\/div>\r\n<div class='center' id='content-body-separator'><\/div>\r\n<div id='sub-list' class='center page-list'>\r\n<\/div>\r\n<div id='fb_components'>\r\n\t<div class=\"fb-comments\"\n  data-href=\"https:\/\/ujnotes.com\/computer\/program\/git\/remote_filesystem\"\n  data-numposts=\"50\">\n<\/div>\n\t<div class=\"fb-like\"\n  data-href=\"https:\/\/ujnotes.com\/computer\/program\/git\/remote_filesystem\"\n  data-layout=\"button\"\n  data-action=\"like\"\n  data-size=\"small\"\n  data-show-faces=\"false\"\n  data-share=\"true\">\n<\/div>\n<\/div>\r\n<div id='nav-list' class='center page-list'>\r\n\t<a id='nav-menu-prev'\r\n\t\t\tclass='XURL item_block_container' href='\/computer\/program\/git\/remote' data-target='computer\/program\/git\/remote' data-title='Remote' >\r\n\t\t<img class='item_block_image item_block_image_visible' src='\/resource\/placeholder.svg' loading='lazy' alt='Navigation - previous page tile'><div class='item_block_text'><div class='arrow'>&#x25C4;<\/div><div>Remote<\/div><\/div>\r\n\t\t<\/a><a id='nav-menu-next'\r\n\t\t\tclass='XURL item_block_container' href='\/computer\/program\/git\/remote_mirror' data-target='computer\/program\/git\/remote_mirror' data-title='Remote 