n\t\t<li><div><code class='inline'>-a<\/code> \u2014 append.<\/div><\/li>\n\t\t<li><div><code class='inline'>&lt;output_file&gt;<\/code> \u2014 destination file<\/div><\/li>\n\t<\/ul>\n<\/div>\n\n<div id='updated-container'>\r\n\t<div id='updated'>\r\n\t\tUpdated:\r\n\t\t<span id='date'>\r\n\t\t\t2026 Aug 19\t\t<\/span>\r\n\t<\/div>\r\n<\/div>\r\n<div class='center' id='content-body-separator'><\/div>\r\n<div id='sub-list' class='center page-list'>\r\n<\/div>\r\n<div id='fb_components'>\r\n\t<div class=\"fb-comments\"\n  data-href=\"https:\/\/ujnotes.com\/computer\/os\/nix\/sh\/output_to_file_and_screen\"\n  data-numposts=\"50\">\n<\/div>\n\t<div class=\"fb-like\"\n  data-href=\"https:\/\/ujnotes.com\/computer\/os\/nix\/sh\/output_to_file_and_screen\"\n  data-layout=\"button\"\n  data-action=\"like\"\n  data-size=\"small\"\n  data-show-faces=\"false\"\n  data-share=\"true\">\n<\/div>\n<\/div>\r\n<div id='nav-list' class='center page-list'>\r\n\t<a id='nav-menu-prev'\r\n\t\t\tclass='XURL item_block_container' href='\/computer\/os\/nix\/sh\/notes' data-target='computer\/os\/nix\/sh\/notes' data-title='Notes' >\r\n\t\t<img class='item_block_image item_block_image_visible item_block_image_contain' src='\/computer\/os\/nix\/sh\/notes.svg' loading='lazy' alt='Navigation - previous page tile'><div class='item_block_text'><div class='arrow'>&#x25C4;<\/div><div>Notes<\/div><\/div>\r\n\t\t<\/a><a id='nav-menu-next'\r\n\t\t\tclass='XURL item_block_container' href='\/computer\/os\/nix\/sh\/shebang' data-target='computer\/os\/nix\/sh\/shebang' data-title='Shebang' >\r\n\t\t<img class='item_block_image item_block_image_visible' src='\/resource\/placeholder.svg' loading='lazy' alt='Navigation - next page tile'><div class='item_block_text'><div>Shebang<\/div><div class='arrow'>&#x25BA;<\/div><\/div>\r\n\t\t<\/a><a id='nav-menu-up' class='XURL item_block_container ' href='\/computer\/os\/nix\/sh' data-target='computer\/os\/nix\/sh' data-title='Sh'>\r\n\t\t<img class='item_block_imag